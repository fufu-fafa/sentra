[Unit]
Description=SENTRA relay (child phone to SENTRA Care)
After=network-online.target
Wants=network-online.target

[Service]
# Replace YOUR_USER with the account the relay runs as. On the VPS, behind HTTPS, add: Environment=LAN_ONLY=0
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/sentra-relay
Environment=PORT=8787
Environment=DB_PATH=/home/YOUR_USER/sentra-relay/relay.db
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
